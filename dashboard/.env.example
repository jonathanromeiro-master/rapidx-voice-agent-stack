# =============================================================================
# RapidX Voice. Environment template.
# Copy this file to .env and fill in the real values. The .env file is
# gitignored and its keys never reach the browser. Placeholders only here.
# No em dashes anywhere in this codebase. Use commas or periods.
# =============================================================================

# ---- Voice engine: Rumik silk TTS (LIVE) ------------------------------------
# The hook. Roughly 20x cheaper than ElevenLabs. Sits behind Cloudflare, so the
# server always sends a browser User-Agent. Do not remove that, it 403s otherwise.
RUMIK_API_KEY=your_rumik_api_key_here

# ---- Brain: Google Gemini (LIVE) --------------------------------------------
# Powers the conversation and the speech-to-text fallback.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ---- Server ----------------------------------------------------------------
PORT=8787

# ---- Telephony: VoiceLink (LIVE) -------------------------------------------
# Outbound dial uses a 10-digit national number plus country_code, NOT full
# E.164. Sending +91... as the customer number causes the call to fail (cause 38).
VOICELINK_BASE=app.voicelink.co.in
VOICELINK_RESELLER_USER=your_voicelink_reseller_user
VOICELINK_RESELLER_PASS=your_voicelink_reseller_pass
VOICELINK_DID=91XXXXXXXXXX

# Public URL of the live voice engine, used for the telephony health check.
ENGINE_TUNNEL=https://your-engine-tunnel.example.com

# =============================================================================
# Optional providers. Leave commented to keep them as ready-to-wire stubs.
# Adding the keys flips the provider to live in Settings, no code change needed.
# =============================================================================

# ---- TTS alternatives ----
# ELEVENLABS_API_KEY=
# SARVAM_API_KEY=

# ---- LLM alternative (only Gemini and Claude are supported, never OpenAI) ----
# ANTHROPIC_API_KEY=

# ---- Telephony alternatives ----
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# =============================================================================
# RapidX Voice Agent Stack.
# Copie para .env, preencha os campos em branco e mantenha o .env fora do Git.
# =============================================================================

# ---- Deployment mode --------------------------------------------------------
# AUTO = detecta CLOUD quando houver VPS_IP + SSH_KEY, senao LOCAL.
DEPLOY_MODE=CLOUD

# ---- VPS / SSH --------------------------------------------------------------
# Valores ja descobertos neste ambiente. Ajuste apenas se mudar a VM ou a chave.
VPS_IP=163.176.48.94
SSH_USER=ubuntu
SSH_KEY=./ssh-key-2026-05-27.key

# Host publico esperado para Dograh quando a VM estiver configurada.
# Exemplo derivado: 163-176-48-94.sslip.io
DOGRAH_HOST=163-176-48-94.sslip.io
DOGRAH_BASE_URL=https://163-176-48-94.sslip.io
DASHBOARD_HOST=studio.163-176-48-94.sslip.io

# ---- Dograh -----------------------------------------------------------------
DOGRAH_EMAIL=
DOGRAH_PASSWORD=

# Preferir chave de API dedicada da organizacao para o dashboard.
DOGRAH_API_KEY=
# Token server-side gerado pelo workflow Dograh publicado para o browser WebRTC.
DOGRAH_EMBED_TOKEN=
DOGRAH_WORKFLOW_ID=
DOGRAH_TELEPHONY_CONFIG_ID=
DOGRAH_PHONE_NUMBER_ID=

# ---- Telephony principal no Brasil -----------------------------------------
TELEPHONY_PROVIDER=brdid_asterisk
TELEPHONY_COUNTRY_CODE=BR

# ---- BR DID + Asterisk ARI --------------------------------------------------
BRDID_SIP_SERVER=
BRDID_SIP_USERNAME=
BRDID_SIP_PASSWORD=
BRDID_SIP_PORT=5060
BRDID_SIP_TRANSPORT=udp
BRDID_CALLER_ID=
BRDID_INBOUND_EXTENSION=

# The dashboard runs in Docker and reaches the private Asterisk service by name.
ASTERISK_ARI_URL=http://asterisk:8088/ari
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=rapidx
# Fixed endpoint configured by services/asterisk/entrypoint.sh.
ASTERISK_SIP_ENDPOINT_ID=brdid
# Carrier-provided destination format. {number} expands to digits only; {e164}
# retains the leading plus. It must render PJSIP/... or SIP/....
ASTERISK_ARI_ENDPOINT_TEMPLATE=

# ---- Telephony fallback: Telnyx --------------------------------------------
TELNYX_API_KEY=
TELNYX_NUMBER=
TELNYX_CONNECTION_ID=

# ---- VoiceLink opcional -----------------------------------------------------
VOICELINK_RESELLER_USER=
VOICELINK_RESELLER_PASS=
VOICELINK_DID=

# ---- Speech to text ---------------------------------------------------------
STT_PROVIDER=local_whisper
LOCAL_STT_BASE_URL=http://rapidx-local-stt:8080
LOCAL_STT_MODEL=small
LOCAL_STT_LANGUAGE=pt
LOCAL_STT_API_KEY=
STT_UPSTREAM_URL=http://rapidx-whisper-engine:8091/inference
STT_UPSTREAM_HEALTH_URL=http://rapidx-whisper-engine:8091/
LOCAL_SPEECH_TIMEOUT_SECONDS=30

# ---- Speech fallback: Deepgram ---------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
DEEPGRAM_LANGUAGE=multi

# ---- LLM --------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- TTS --------------------------------------------------------------------
TTS_PROVIDER=local_piper
LOCAL_TTS_BASE_URL=http://rapidx-local-tts:8090
LOCAL_TTS_MODEL=piper
LOCAL_TTS_VOICE=pt_BR-faber-medium
LOCAL_TTS_API_KEY=none
TTS_UPSTREAM_URL=http://rapidx-piper-engine:5000/synthesize
TTS_UPSTREAM_HEALTH_URL=http://rapidx-piper-engine:5000/info

# ---- TTS fallback: Rumik ----------------------------------------------------
RUMIK_API_KEY=
RUMIK_MODEL=mulberry
RUMIK_VOICE=ira

# ---- Verification -----------------------------------------------------------
# So usar apos sua confirmacao explicita para teste de chamada paga.
TEST_NUMBER=

# ---- Dashboard / local UI ---------------------------------------------------
DASHBOARD_PORT=8787

# =============================================================================
# Notas
# - Nao preencha nem commite segredos em arquivos versionados.
# - BR DID + Asterisk e speech local sao o alvo primario desta migracao.
# - Telnyx, Deepgram e Rumik permanecem como fallback durante a transicao.
# - Se voce for usar LOCAL mode depois, este mesmo .env serve como base.
# =============================================================================
